/F1 10 Tf
54 720 Td
(SET DATE_VENTE = NULL) Tj
0 -12 Td
(WHERE DATE_VENTE IS NULL) Tj
0 -12 Td
(   OR DATE_VENTE = '') Tj
0 -12 Td
(   OR DATE_VENTE NOT REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}$';) Tj
0 -12 Td
(- **Fonction** : repérer les dates invalides.) Tj
0 -12 Td
(- **Raison** : éviter les conversions en erreur.) Tj
0 -12 Td
(- **Résultat attendu** : dates invalides remplacées par NULL.) Tj
0 -12 Td
() Tj
0 -12 Td
(UPDATE staging_ventes) Tj
0 -12 Td
(SET PRIX_UNITAIRE = NULL) Tj
0 -12 Td
(WHERE PRIX_UNITAIRE IN \('NaN', 'None', ''\)) Tj
0 -12 Td
(   OR CAST\(PRIX_UNITAIRE AS DECIMAL\(10,2\)\) <= 0;) Tj
0 -12 Td
(- **Fonction** : neutraliser les prix invalides ou négatifs.) Tj
0 -12 Td
(- **Raison** : préserver la cohérence financière.) Tj
0 -12 Td
(- **Résultat attendu** : prix invalides mis à NULL.) Tj
0 -12 Td
() Tj
