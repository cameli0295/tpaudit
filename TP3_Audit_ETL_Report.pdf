0 -12 Td
(### 5\) Fusion produits + articles \(dimension\)) Tj
0 -12 Td
(CREATE TABLE dim_produits AS) Tj
0 -12 Td
(SELECT) Tj
0 -12 Td
(  p.ID_PRODUIT,) Tj
0 -12 Td
(  COALESCE\(p.NOM_PRODUIT, a.NOM_ARTICLE\) AS NOM_PRODUIT,) Tj
0 -12 Td
(  COALESCE\(p.CATEGORIE, a.CATEGORIE\) AS CATEGORIE,) Tj
0 -12 Td
(  CAST\(NULLIF\(p.PRIX_CATALOGUE, 'NaN'\) AS DECIMAL\(10,2\)\) AS PRIX_CATALOGUE,) Tj
0 -12 Td
(  CAST\(NULLIF\(p.STOCK, 'NaN'\) AS SIGNED\) AS STOCK,) Tj
0 -12 Td
(  a.FOURNISSEUR,) Tj
0 -12 Td
(  a.DATE_AJOUT,) Tj
0 -12 Td
(  a.ACTIF,) Tj
0 -12 Td
(  a.TAUX_TVA) Tj
0 -12 Td
(FROM staging_produits p) Tj
0 -12 Td
(LEFT JOIN staging_articles a) Tj
0 -12 Td
(  ON p.ID_PRODUIT = a.ID_ARTICLE;) Tj
0 -12 Td
(- **Fonction** : créer une dimension produit fusionnée.) Tj
0 -12 Td
(- **Raison** : obtenir une vue unique des références produits/articles.) Tj
0 -12 Td
(- **Résultat attendu** : table `dim_produits` prête pour l’analyse.) Tj
0 -12 Td
() Tj
0 -12 Td
(### 6\) Fusion des ventes avec la dimension) Tj
0 -12 Td
(CREATE TABLE ventes_analyse AS) Tj
0 -12 Td
(SELECT) Tj
0 -12 Td
(  v.ID_VENTE,) Tj
0 -12 Td
(  v.DATE_VENTE,) Tj
0 -12 Td
(  v.ID_PRODUIT,) Tj
0 -12 Td
(  v.CLIENT,) Tj
0 -12 Td
(  v.QUANTITE,) Tj
0 -12 Td
(  CAST\(v.PRIX_UNITAIRE AS DECIMAL\(10,2\)\) AS PRIX_UNITAIRE,) Tj
0 -12 Td
(  v.VILLE,) Tj
0 -12 Td
(  \(v.QUANTITE * CAST\(v.PRIX_UNITAIRE AS DECIMAL\(10,2\)\)\) AS TOTAL_VENTE,) Tj
ET
endstream
