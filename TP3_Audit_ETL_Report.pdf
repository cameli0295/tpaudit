(### 4\) Uniformisation des textes) Tj
0 -12 Td
(UPDATE staging_ventes) Tj
0 -12 Td
(SET CLIENT = UPPER\(CLIENT\),) Tj
0 -12 Td
(    VILLE = UPPER\(VILLE\);) Tj
0 -12 Td
(- **Fonction** : homogénéiser les libellés.) Tj
0 -12 Td
(- **Raison** : éviter des doublons logiques lors des regroupements.) Tj
0 -12 Td
